# Copy to .env.local for local development. On Vercel, set the same names under
# Project → Settings → Environment Variables and REDEPLOY: NEXT_PUBLIC_* values
# are inlined at build time, so adding them without a new build does nothing.

# ── Required for the real (non-demo) app ─────────────────────────────────────
# Supabase → Project Settings → API. Without these only demo mode works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional: Turkish loan rates for the loan-rate picker ────────────────────
# Free key from https://evds2.tcmb.gov.tr (profile → API key). Weekly market
# averages per loan type. Server-only.
TCMB_EVDS_KEY=
# Paid/metered key from https://collectapi.com. Per-bank loan offers, and a
# third gold provider (gold already works without it). Paste the bare token,
# without the "apikey " prefix. Server-only.
COLLECT_API_KEY=

# ── Optional: rate history (written to fx_rates, but nothing reads it yet) ───
# Supabase → Project Settings → API → service_role. Bypasses RLS: server-only,
# never prefix it with NEXT_PUBLIC_. Leaving it unset loses nothing today.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: endpoint overrides, only if a provider moves ───────────────────
# TRUNCGIL_URL=https://finance.truncgil.com/api/today.json
# GENELPARA_GOLD_URL=https://api.genelpara.com/embed/altin.json
# GENELPARA_FX_URL=https://api.genelpara.com/embed/doviz.json
# COLLECT_API_GOLD_URL=https://api.collectapi.com/economy/goldPrice
# COLLECT_API_LOAN_URL=https://api.collectapi.com/economy/loans
# TCMB_EVDS_URL=https://evds2.tcmb.gov.tr/service/evds
# TCMB_EVDS_SERIES=

# ── Tests only (Playwright) ──────────────────────────────────────────────────
# BASE_URL=http://localhost:3000
# PW_CHROMIUM_PATH=/path/to/chromium   # use a preinstalled Chromium
